/* 三术合参页样式 */
.report { padding: 10rpx 0; }
.report-item {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 8rpx;
  margin-bottom: 16rpx;
  line-height: 1.8;
}
.report-label {
  font-size: 24rpx;
  color: #9a8a74;
  min-width: 120rpx;
}
.report-tag {
  display: inline-block;
  font-size: 24rpx;
  font-weight: 700;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
}
.report-tag.gold2 {
  color: #f5deb0;
  background: rgba(230,192,122,.12);
  border: 1rpx solid #e6c07a;
}
.report-desc {
  font-size: 26rpx;
  color: #e8ddcb;
  flex: 1;
  min-width: 300rpx;
}
.cross-check {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx dashed #3a2e22;
  font-size: 24rpx;
  line-height: 1.8;
}
.agree { color: #8fbc8f; font-weight: 600; }
.disagree { color: #e08080; font-weight: 600; }

.ai-prompt {
  width: 100%;
  background: #14100c;
  border: 1rpx solid #3a2e22;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 22rpx;
  color: #e8ddcb;
  font-family: monospace;
  min-height: 300rpx;
  box-sizing: border-box;
}
.btn-row {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
  justify-content: center;
}
