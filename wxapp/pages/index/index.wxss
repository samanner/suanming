.header {
  text-align: center;
  padding: 40rpx 0 16rpx;
}
.seal {
  display: inline-block;
  width: 88rpx;
  height: 88rpx;
  line-height: 84rpx;
  border: 3rpx solid #c0392b;
  color: #c0392b;
  font-size: 44rpx;
  font-weight: 800;
  border-radius: 12rpx;
  transform: rotate(-3deg);
  margin-bottom: 16rpx;
  background: rgba(192, 57, 43, .08);
  text-align: center;
}
.title {
  font-size: 44rpx;
  letter-spacing: 14rpx;
  color: #f5deb0;
  font-weight: 800;
}
.subtitle {
  font-size: 22rpx;
  color: #9a8a74;
  letter-spacing: 6rpx;
  margin-top: 10rpx;
}
.time-toggle {
  display: flex;
  align-items: center;
}
.entry-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
