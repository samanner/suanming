<!-- 首页 · 开盘表单 -->
<view class="nav-wrap" style="padding-top: {{statusBarHeight}}px;">
  <view class="navbar">
    <view class="nav-title">赛博命理馆</view>
  </view>
</view>

<view class="container" style="padding-top: {{statusBarHeight + 44}}px;">

  <!-- 头部 -->
  <view class="header">
    <view class="seal">占</view>
    <view class="title">赛博命理馆</view>
    <view class="subtitle">八字 · 紫微 · 三术交叉验证</view>
  </view>

  <!-- 开盘表单 -->
  <view class="card">
    <view class="card-title">开 盘</view>

    <view class="form-item">
      <text class="label">姓名（可选）</text>
      <input class="input" placeholder="求测人" placeholder-class="input-placeholder"
             value="{{name}}" bindinput="onNameInput" />
    </view>

    <view class="form-item">
      <text class="label">性别（决定大运顺逆）</text>
      <picker range="{{genderOptions}}" value="{{genderIndex}}" bindchange="onGenderChange">
        <view class="picker-value">{{genderOptions[genderIndex]}}</view>
      </picker>
    </view>

    <view class="form-item">
      <text class="label">出生日期（阳历）</text>
      <picker mode="date" value="{{dateValue}}" bindchange="onDateChange">
        <view class="picker-value">{{dateValue}}</view>
      </picker>
    </view>

    <view class="form-item">
      <view class="label-row">
        <text class="label">出生时间</text>
        <view class="time-toggle">
          <text class="dim" style="font-size:22rpx;margin-right:12rpx;">时辰不详</text>
          <switch checked="{{hasTime}}" bindchange="onTimeToggle" color="#e6c07a" />
        </view>
      </view>
      <picker mode="time" value="{{timeValue}}" disabled="{{!hasTime}}" bindchange="onTimeChange">
        <view class="picker-value {{hasTime ? '' : 'disabled'}}">{{hasTime ? timeValue : '— 时辰不详 —'}}</view>
      </picker>
    </view>

    <view class="btn-area">
      <button class="btn-primary" bindtap="onPaipan">起 盘</button>
    </view>

    <view class="hint">时辰不确定可关闭开关，仅排八字前三柱；紫微斗数需精确时辰</view>

    <view class="err-box" wx:if="{{errMsg}}">{{errMsg}}</view>
  </view>

  <!-- 历史入口 -->
  <view class="card" bindtap="goHistory">
    <view class="entry-row">
      <text class="gold" style="font-size:28rpx;">📋 历史命例</text>
      <text class="dim" style="font-size:36rpx;">›</text>
    </view>
  </view>

  <!-- 免责声明 -->
  <view class="disclaimer">
    本馆排盘由开源历法引擎（lunar-javascript / iztro）确定性计算
    解读部分为规则模板，仅供参考娱乐
    命由己造，相由心生 —— 切勿以此替代医疗、法律、投资决策
  </view>
</view>
